# Backend API URL (Production: https://vnnet-vn-java.onrender.com | Local: http://localhost:8000)
NEXT_PUBLIC_API_URL=https://vnnet-vn-java.onrender.com

# Google OAuth Client ID (Get from Google Cloud Console -> APIs & Services -> Credentials)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Mapbox Access Token (Get from https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
