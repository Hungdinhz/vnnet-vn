# Server Configuration
SERVER_PORT=8000

# Database Configuration (PostgreSQL / Neon DB)
DB_HOST=your-database-host.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_SSLMODE=require
DB_USERNAME=your-database-username
DB_PASSWORD=your-database-password

# JWT Authentication
# Secret key should be a secure, random hexadecimal string of at least 256 bits (64 characters)
JWT_SECRET=your-super-secret-key-at-least-64-characters-long
JWT_EXPIRATION=1800000

# Cloudinary Integration (for Media Uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
